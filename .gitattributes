# Normalize line endings; LF in the repo
* text=auto eol=lf

*.sh   text eol=lf
*.c    text eol=lf
*.cpp  text eol=lf
*.h    text eol=lf
*.hpp  text eol=lf
*.php  text eol=lf

# Binaries
*.so     binary
*.a      binary
*.png    binary
*.avif   binary
*.jxl    binary
*.heic   binary
*.heif   binary
*.tar.gz binary
